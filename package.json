{
  "name": "bloub",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "Build, animate and export the four-legged Kumo logo as editable SVG, PNG, GIF or video.",
  "license": "MIT",
  "author": "Jérémy Perret",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zachshotamartin/bloub.git"
  },
  "keywords": [
    "svg",
    "animation",
    "avatar",
    "logo-builder",
    "kumo",
    "vue",
    "morphing"
  ],
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:vercel-account": "node scripts/verify-vercel-account.mjs"
  },
  "dependencies": {
    "mediabunny": "^1.54.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "happy-dom": "^20.11.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vercel": "^59.4.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
